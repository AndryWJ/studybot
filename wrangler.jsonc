// Налаштування Cloudflare Worker. Секрети (токени, ключі) тут не зберігаються:
// їх задають командою `npx wrangler secret put <НАЗВА>`, а локально у файлі .dev.vars.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "studybot",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-15",
	"observability": {
		"enabled": true
	},
	// Раз на хвилину Cloudflare викликає scheduled() із src/index.ts: нагадування,
	// ранкові зведення і повідомлення про заняття. Розклад завжди в UTC.
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "studybot",
			// id бази з виводу `npx wrangler d1 create studybot`; ще раз його покаже `npx wrangler d1 list`.
			"database_id": "9297a79e-6794-4c17-a785-256a59659702",
			"migrations_dir": "migrations"
		}
	],
	// Workers AI: запасний ШІ без ключів, 10 000 "нейронів" на добу безкоштовно.
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"vars": {
		"DEFAULT_TZ": "Europe/Kyiv",
		// Порядок спроб: якщо перший ШІ недоступний або вичерпав ліміт, бот питає наступного.
		// Провайдери без ключа пропускаються.
		"AI_PROVIDERS": "groq,gemini,custom,workers",
		"GROQ_MODELS": "openai/gpt-oss-120b,openai/gpt-oss-20b",
		"GROQ_VISION_MODEL": "",
		"GEMINI_MODELS": "gemini-3.5-flash-lite",
		"CUSTOM_AI_BASE_URL": "",
		"CUSTOM_AI_MODELS": "",
		"CUSTOM_AI_VISION": "",
		"WORKERS_AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
		// Скільки запитів до ШІ на добу може зробити один користувач (0 означає без обмеження).
		"AI_DAILY_LIMIT": "40",
		// Telegram id через кому: якщо задано, бот відповідає лише цим людям.
		"ALLOWED_USERS": "",
		// Telegram id адміністратора для команди /stats.
		"ADMIN_ID": ""
	}
}